# Capim Dourado Connect — exemplo de configuração local
# Copie este arquivo para .env e preencha com os valores do seu projeto.
# Variáveis com prefixo VITE_ são públicas e ficam disponíveis no navegador.

# Configuração de uso exclusivo no servidor (se necessária)
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_sua-chave-publica"
SUPABASE_URL="https://seu-projeto.supabase.co"

# Configuração pública do frontend (Vite)
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_sua-chave-publica"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
